+
+    /* Kempston mouse (ZX-PLC): the PC pointer is hidden over the canvas and the Spectrum
+    pointer follows it (no pointer lock, so Esc stays a normal key). The counters are the
+    pointer position on the Spectrum screen (0-255, 0-191, Y counter upwards); they move
+    towards it by at most 40 pixels per frame, as a program reads 8-bit signed deltas.
+    Returns the function that sends the state to the core. */
+    setupKempstonMouse() {
+        const canvas = this.canvas;
+        canvas.style.cursor = 'none';
+        let tx = 128, ty = 96, x = 128, y = 96, buttons = 0xff;
+        const send = () => {
+            this.worker.postMessage({message: 'setMouse', x: x & 0xff, y: (191 - y) & 0xff, buttons: buttons});
+        };
+        const step = (from, to) => Math.max(-40, Math.min(40, to - from));
+        setInterval(() => {
+            if (x != tx || y != ty) {
+                x += step(x, tx);
+                y += step(y, ty);
+                send();
+            }
+        }, 20);
+        canvas.addEventListener('mousemove', (e) => {
+            const r = canvas.getBoundingClientRect();
+            const sx = (e.clientX - r.left) * canvas.width / r.width - 32;   // border: 32 / 24 pixels
+            const sy = (e.clientY - r.top) * canvas.height / r.height - 24;
+            tx = Math.max(0, Math.min(255, Math.floor(sx)));
+            ty = Math.max(0, Math.min(191, Math.floor(sy)));
+        });
+        const bit = (e) => (e.button == 0) ? 2 : (e.button == 2) ? 1 : 0;
+        canvas.addEventListener('mousedown', (e) => {
+            if (bit(e)) {
+                buttons &= ~bit(e);
+                send();
+            }
+        });
+        document.addEventListener('mouseup', (e) => {
+            if (bit(e) && !(buttons & bit(e))) {
+                buttons |= bit(e);
+                send();
+            }
+        });
+        canvas.addEventListener('contextmenu', (e) => e.preventDefault());
+        return send;
+    }
 }
 
